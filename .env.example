# Optional: enables MapTiler satellite imagery and 3D terrain in /atlas.
VUE_APP_MAPTILER_KEY=

# Optional: overrides the default MapTiler hybrid-v4 style.
VUE_APP_MAPTILER_STYLE_URL=

# Private local media uploader settings. Do not use VUE_APP_ prefixes: these
# values are for scripts/upload-media.js and must never enter the browser build.
MEDIA_UPLOAD_WORKER_URL=
MEDIA_UPLOAD_TOKEN=
