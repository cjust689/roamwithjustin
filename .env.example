# Optional: enables MapTiler satellite imagery and 3D terrain in /atlas.
VUE_APP_MAPTILER_KEY=

# Optional local My Atlas proof and Auth0 Universal Login. The values below are
# public browser configuration, not client secrets. Production remains disabled
# unless its build explicitly enables the feature.
VUE_APP_ENABLE_MY_ATLAS_GEOGRAPHIC_PROOF=false
VUE_APP_MY_ATLAS_AUTH0_DOMAIN=example.us.auth0.com
VUE_APP_MY_ATLAS_AUTH0_CLIENT_ID=replace-with-spa-client-id
VUE_APP_MY_ATLAS_AUTH0_AUDIENCE=https://api.example.com
VUE_APP_MY_ATLAS_API_URL=http://127.0.0.1:8787
VUE_APP_MY_ATLAS_PLACE_SEARCH_URL=http://127.0.0.1:8788/v1/places/search
VUE_APP_MY_ATLAS_TURNSTILE_SITEKEY=replace-with-public-sitekey

# Optional manual AdSense integration. Live ads remain disabled unless every
# flag and identifier below is valid. Confirm Auto ads is off in the AdSense
# dashboard before setting the final confirmation flag.
VUE_APP_ADSENSE_ENABLED=false
VUE_APP_ADSENSE_PRIVACY_READY=false
VUE_APP_ADSENSE_AUTO_ADS_OFF_CONFIRMED=false
VUE_APP_ADSENSE_CLIENT_ID=
VUE_APP_ADSENSE_STORY_SLOT_ID=

# Optional Atlas unit. It remains independent of the story unit and is capped
# to one eligible request per guided Journey and browser-tab session.
VUE_APP_ADSENSE_ATLAS_ENABLED=false
VUE_APP_ADSENSE_ATLAS_SLOT_ID=

# Exact public ads.txt line copied from AdSense. This is consumed only by the
# postbuild step and is written to dist/ads.txt when supplied.
ADSENSE_GOOGLE_ADS_TXT_LINE=

# Private local media uploader settings. Do not use VUE_APP_ prefixes: these
# values are for scripts/upload-media.js and must never enter the browser build.
MEDIA_UPLOAD_WORKER_URL=
MEDIA_UPLOAD_TOKEN=
