# Optional: enables MapTiler satellite imagery and 3D terrain in /atlas.
VUE_APP_MAPTILER_KEY=

# Optional: overrides the default MapTiler hybrid-v4 style.
VUE_APP_MAPTILER_STYLE_URL=

# Optional manual AdSense integration. Live ads remain disabled unless every
# flag and identifier below is valid. Confirm Auto ads is off in the AdSense
# dashboard before setting the final confirmation flag.
VUE_APP_ADSENSE_ENABLED=false
VUE_APP_ADSENSE_PRIVACY_READY=false
VUE_APP_ADSENSE_AUTO_ADS_OFF_CONFIRMED=false
VUE_APP_ADSENSE_CLIENT_ID=
VUE_APP_ADSENSE_STORY_SLOT_ID=

# Exact public ads.txt line copied from AdSense. This is consumed only by the
# postbuild step and is written to dist/ads.txt when supplied.
ADSENSE_GOOGLE_ADS_TXT_LINE=

# Private local media uploader settings. Do not use VUE_APP_ prefixes: these
# values are for scripts/upload-media.js and must never enter the browser build.
MEDIA_UPLOAD_WORKER_URL=
MEDIA_UPLOAD_TOKEN=
