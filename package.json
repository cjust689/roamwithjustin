{
  "name": "unityarm-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "serve": "node scripts/serve.js",
    "server": "node scripts/serve.js",
    "content:validate": "node scripts/validate-content.js",
    "docs:audit": "node scripts/docs-audit.mjs",
    "my-atlas:catalog": "node scripts/my-atlas/build-place-catalog.mjs",
    "my-atlas:catalog:worker": "node scripts/my-atlas/build-worker-place-catalog.mjs --catalog .state/my-atlas/catalog-full.json --output-dir .state/my-atlas/worker-catalog",
    "my-atlas:search:local": "node scripts/my-atlas/local-place-search-server.mjs --source-dir .state/my-atlas/geonames --port 8788",
    "my-atlas:serve": "node scripts/serve.js --my-atlas --port 8080",
    "my-atlas:test": "node scripts/test-my-atlas-place-catalog.mjs && npm run my-atlas:worker:test && npm run my-atlas:worker:durable:test",
    "my-atlas:worker:test": "node scripts/test-my-atlas-worker.mjs",
    "my-atlas:worker:durable:test": "vitest run --config workers/my-atlas/vitest.config.mjs",
    "my-atlas:worker:dev": "wrangler dev --local --config workers/my-atlas/wrangler.jsonc",
    "my-atlas:worker:check": "wrangler deploy --dry-run --config workers/my-atlas/wrangler.jsonc",
    "my-atlas:worker:check:staging": "wrangler deploy --dry-run --env staging --config workers/my-atlas/wrangler.jsonc",
    "editorial:baseline": "node scripts/editorial-baseline.mjs",
    "editorial:bind:places": "node scripts/editorial-bind-places.mjs",
    "editorial:bind:journeys": "node scripts/editorial-bind-journeys.mjs",
    "editorial:bind:reviewed-places": "node scripts/editorial-bind-reviewed-places.mjs",
    "editorial:bind:visits": "node scripts/editorial-bind-visits.mjs",
    "editorial:catalog": "node scripts/editorial-build-catalog.mjs",
    "editorial:github:audit": "node scripts/editorial-github-audit.mjs",
    "editorial:github:configure": "node scripts/editorial-github-configure.mjs",
    "editorial:github:publish": "node scripts/editorial-github-publish.mjs",
    "editorial:migrate": "node scripts/editorial-migrate-sheet.mjs",
    "editorial:publish": "node scripts/editorial-publish.mjs",
    "editorial:register:place": "node scripts/editorial-register-place.mjs",
    "editorial:suggest:places": "node scripts/editorial-suggest-places.mjs",
    "editorial:test": "node scripts/test-editorial-baseline.mjs && node scripts/test-editorial-google.mjs && node scripts/test-editorial-migration.mjs && node scripts/test-editorial-catalog.mjs && node scripts/test-editorial-bindings.mjs && node scripts/test-editorial-place-suggestions.mjs && node scripts/test-editorial-place-decisions.mjs && node scripts/test-editorial-visits.mjs && node scripts/test-editorial-story-generator.mjs && node scripts/test-editorial-content-compiler.mjs && node scripts/test-editorial-place-registration.mjs && node scripts/test-editorial-publication-plan.mjs && node scripts/test-editorial-github.mjs && node scripts/test-editorial-github-rules.mjs && node scripts/test-editorial-github-publisher.mjs && node scripts/test-editorial-publication-writeback.mjs",
    "adsense:test": "node scripts/test-adsense-config.mjs && node scripts/test-atlas-ad-eligibility.mjs",
    "adsense:validate": "node scripts/validate-adsense-config.mjs",
    "atlas:test": "node scripts/test-atlas-marker-layout.mjs && node scripts/test-atlas-surprise-selection.mjs && node scripts/test-atlas-journey-readiness.mjs",
    "gear:ingest": "node scripts/ingest-gear.js",
    "gear:journeys": "node scripts/ingest-gear.js --journeys",
    "gear:list": "node scripts/ingest-gear.js --list",
    "gear:test": "node scripts/test-gear-ingestion.js",
    "gear:validate": "node scripts/validate-content.js",
    "build": "npm run docs:audit && npm run content:validate && npm run adsense:test && npm run adsense:validate && npm run my-atlas:test && vue-cli-service build",
    "postbuild": "node scripts/prepare-pages.js",
    "images:optimize": "node scripts/optimize-images.js",
    "images:optimize:copies": "node scripts/optimize-images.js --copy",
    "images:optimize:dry": "node scripts/optimize-images.js --dry-run",
    "media:prepare": "node scripts/optimize-images.js --package",
    "media:cull": "node scripts/cull-media.js",
    "media:ingest": "node scripts/ingest-media.js",
    "media:journeys": "node scripts/ingest-media.js --journeys",
    "media:places": "node scripts/ingest-media.js --places",
    "media:test": "node scripts/test-media-ingestion.js && node scripts/test-media-upload.js && node scripts/test-media-culling.js",
    "media:upload": "node scripts/upload-media.js",
    "media:upload:test": "node scripts/test-media-upload.js",
    "media:validate": "node scripts/validate-content.js",
    "media:worker:dev": "wrangler dev --config workers/media-upload/wrangler.jsonc",
    "media:worker:check": "wrangler deploy --dry-run --config workers/media-upload/wrangler.jsonc",
    "media:worker:deploy": "wrangler deploy --config workers/media-upload/wrangler.jsonc",
    "media:worker:secret": "wrangler secret put MEDIA_UPLOAD_TOKEN --config workers/media-upload/wrangler.jsonc",
    "lint": "vue-cli-service lint",
    "start": "node server server.js"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.30.0",
    "core-js": "^3.6.5",
    "d3-geo": "^3.1.1",
    "express": "^4.17.1",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.0",
    "jquery": "^3.6.0",
    "maplibre-gl": "^6.18.0",
    "topojson-client": "^3.1.0",
    "vue": "^2.6.11",
    "vue-router": "^3.2.0",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "@mapbox/jsonlint-lines-primitives": "2.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@vue/babel-preset-app": "^4.5.13",
    "@vue/cli-plugin-babel": "^5.0.8",
    "@vue/cli-plugin-eslint": "^5.0.8",
    "@vue/cli-plugin-router": "^5.0.8",
    "@vue/cli-plugin-vuex": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "babel-eslint": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.5.3",
    "sharp": "^0.35.5",
    "vitest": "^4.1.0",
    "vue-template-compiler": "^2.6.11",
    "wrangler": "4.162.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
