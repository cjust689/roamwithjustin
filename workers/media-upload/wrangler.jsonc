{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "roamwithjustin-media-upload",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "roamwithjustin-media"
    }
  ],
  "vars": {
    "ALLOWED_R2_PREFIXES": "images/,videos/",
    "MAX_IMAGE_UPLOAD_BYTES": "26214400",
    "MAX_VIDEO_UPLOAD_BYTES": "199229440",
    "MAX_MULTIPART_PART_BYTES": "16777216"
  }
}
